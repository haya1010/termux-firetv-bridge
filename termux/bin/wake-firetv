#!/data/data/com.termux/files/usr/bin/sh
set -eu

serial="${FIRETV_SERIAL:-192.168.0.42:5555}"
component="${FIRETV_COMPONENT:-jp.kusakabesatsu.chihiro/.MainActivity}"
adb connect "$serial" >/dev/null
adb -s "$serial" shell input keyevent 3
sleep 4
adb -s "$serial" shell am start -n "$component" \
  --es server_url ws://192.168.0.10:8080/ws
